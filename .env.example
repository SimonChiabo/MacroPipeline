# --- Data Sources API Keys ---
FRED_API_KEY=your_fred_api_key
FMP_API_KEY=your_fmp_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# --- LLM ---
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Social Media APIs ---
# X (Twitter). Las cuatro son de OAuth 1.0a user context: las dos primeras
# identifican la app, las dos ultimas la cuenta que publica.
# IMPORTANTE: regenerar Access Token y Secret DESPUES de poner la app en
# "Read and write". Los emitidos con permiso de solo lectura siguen siendo
# validos y fallan con 403 al publicar, sin decir por que.
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret

# LinkedIn. CLIENT_ID y CLIENT_SECRET solo se usan para emitir el token; el
# pipeline en si necesita ACCESS_TOKEN y PERSON_URN.
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
# Autor de la publicacion. Se obtiene de GET /v2/userinfo (campo `sub`):
#   python scripts/check_publishers.py
LINKEDIN_PERSON_URN=urn:li:person:tu_id_de_linkedin
# LinkedIn access tokens expiran cada ~60 días. Anotar fecha de emisión aquí:
# LINKEDIN_TOKEN_ISSUED=2026-05-15

# --- HITL (Telegram) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# CRÍTICO: sin este valor, cualquier miembro del chat puede aprobar publicaciones.
# Obtener tu user_id enviando /start a @userinfobot en Telegram.
TELEGRAM_ALLOWED_USER_ID=your_telegram_numeric_user_id

# --- Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=macropipeline-snapshots

# --- Estado local (SQLite) ---
# Ruta absoluta para el archivo de estado. Si no se define, usa ~/.macropipeline/state.db
# IMPORTANTE: no dejar en blanco si el scheduler puede ejecutar desde distintos directorios.
STATE_DB_PATH=/absolute/path/to/macropipeline/state.db

# --- Seguridad de datos ---
# false en producción (bloquea publicación con datos sintéticos)
# true solo en desarrollo/testing para probar el pipeline completo sin APIs reales
ALLOW_MOCK_DATA=false

# --- Observability (Grafana Cloud) ---
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic...
